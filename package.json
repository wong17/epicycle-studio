{
  "name": "epicycle-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/run.mjs ng serve --host 127.0.0.1",
    "build": "node scripts/run.mjs scripts/prepare-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run.mjs ng test",
    "test:ci": "node scripts/run.mjs ng test --no-watch --no-progress",
    "test:coverage": "node scripts/run.mjs ng test --no-watch --coverage",
    "lint": "node scripts/run.mjs eslint src tests",
    "format:check": "node scripts/run.mjs prettier --check src tests scripts docs package.json angular.json tsconfig*.json playwright.config.ts eslint.config.js .github/workflows README.md",
    "format": "node scripts/run.mjs prettier --write src tests scripts docs package.json angular.json tsconfig*.json playwright.config.ts eslint.config.js .github/workflows README.md",
    "test:e2e": "node scripts/run.mjs playwright test",
    "preview": "node scripts/run.mjs scripts/serve.mjs"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "fft.js": "4.0.4",
    "idb": "8.0.4",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.4",
    "angular-eslint": "22.6.0",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
